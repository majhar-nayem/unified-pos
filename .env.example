# Local development defaults (match infra/docker/docker-compose.yml)
DATABASE_URL=postgres://pos:pos@localhost:5432/pos
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pos-local

# Identity (platform-native auth). Generate with: pnpm --filter @pos/api auth:keygen
# Unset outside production = ephemeral keys at boot (tokens and sealed TOTP secrets do not survive restarts).
AUTH_JWT_KID=
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_JWKS=
AUTH_SECRETS_KEY=
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_ORIGINS=http://localhost:3001,http://localhost:5173
# Platform operators (tenant provisioning) until an operator IdP exists: "operatorId:op_<secret>,..."
AUTH_OPERATOR_TOKENS=

# Rate limiting (docs/01 §5.1 step 1): Redis token buckets per tenant+principal and per IP for
# anonymous requests. CAPACITY is the burst, REFILL_PER_SECOND the sustained rate. Public API
# callers are refused (429) while Redis is unavailable; pos/device tokens pass with a warning log.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=300
RATE_LIMIT_REFILL_PER_SECOND=100
RATE_LIMIT_PUBLIC_CAPACITY=60
RATE_LIMIT_PUBLIC_REFILL_PER_SECOND=10
