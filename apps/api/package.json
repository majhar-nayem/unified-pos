{
  "name": "@pos/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP + WebSocket + sync API (modular monolith)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "auth:keygen": "tsx src/modules/identity/crypto/keygen.ts",
    "openapi:export": "node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@pos/auth": "workspace:*",
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain-core": "workspace:*",
    "@pos/observability": "workspace:*",
    "@pos/payments-sdk": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "otpauth": "9.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@pos/testing": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
