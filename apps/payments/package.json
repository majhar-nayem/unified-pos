{
  "name": "@pos/payments",
  "version": "0.0.0",
  "private": true,
  "description": "Payments deployable (ADR-019): webhook intake, stuck-payment and offline-expiry sweepers, provider adapters, with its own secrets. Reuses the payments module of apps/api.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@pos/api": "workspace:*",
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/observability": "workspace:*",
    "@pos/payments-sdk": "workspace:*",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@pos/testing": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
