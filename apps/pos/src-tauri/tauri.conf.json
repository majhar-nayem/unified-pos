{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS",
  "version": "0.0.0",
  "identifier": "com.unifiedpos.register",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "POS",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
