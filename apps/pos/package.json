{
  "name": "@pos/pos",
  "version": "0.0.0",
  "private": true,
  "description": "Tauri 2 + React POS app (retail checkout, restaurant order entry, CFD mode)",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --port 1420 --strictPort",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dev:mock-api": "node e2e/mock-api.mjs",
    "seed:dev": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@pos/contracts": "workspace:*",
    "@pos/domain-core": "workspace:*",
    "@pos/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@pos/hardware": "workspace:*",
    "@pos/sync-protocol": "workspace:*",
    "@tauri-apps/plugin-sql": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
