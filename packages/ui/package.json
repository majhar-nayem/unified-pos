{
  "name": "@pos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design system: tokens (JSON source of truth), themes, React primitives and composites shared by admin, POS and KDS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./dist/tokens.resolved.json",
    "./eslint": "./eslint/index.js"
  },
  "files": [
    "dist",
    "eslint",
    "tokens"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.js src eslint scripts .storybook playwright && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o node_modules/.cache/storybook-static --quiet",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "messages": "node scripts/build-messages.mjs",
    "generate": "pnpm run tokens && pnpm run messages",
    "generate:check": "node scripts/build-tokens.mjs --check && node scripts/build-messages.mjs --check"
  },
  "dependencies": {
    "intl-messageformat": "12.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
