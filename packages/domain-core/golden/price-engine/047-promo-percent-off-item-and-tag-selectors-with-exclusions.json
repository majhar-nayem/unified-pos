{
  "name": "promo percent_off: item and tag selectors with exclusions",
  "description": "Targets tag hot but excludes variant v-soup: only the coffee (500) is discounted 10% = 50.",
  "tags": ["promo", "percent_off", "selector"],
  "input": {
    "draft": {
      "currency": "AUD",
      "lines": [
        {
          "id": "l1",
          "variantId": "v-coffee",
          "quantity": "1",
          "defaultUnitPriceMinor": 500,
          "tags": ["hot"]
        },
        {
          "id": "l2",
          "variantId": "v-soup",
          "quantity": "1",
          "defaultUnitPriceMinor": 900,
          "tags": ["hot"]
        }
      ]
    },
    "context": {
      "at": "2026-10-19T02:00:00Z",
      "timezone": "Australia/Sydney",
      "locationId": "loc-syd",
      "orgUnitPath": ["ou-nsw", "ou-root"],
      "channel": "pos",
      "jurisdiction": { "country": "AU", "region": "NSW" },
      "promotions": [
        {
          "id": "p",
          "name": "p",
          "kind": "percent_off",
          "rules": {
            "version": 1,
            "targets": { "tags": ["hot"], "excludeVariantIds": ["v-soup"] },
            "effect": { "kind": "percent_off", "percent": "10" }
          },
          "validFrom": "2026-01-01T00:00:00Z",
          "status": "active"
        }
      ]
    }
  },
  "expected": { "promotionDiscountMinor": 50, "totalMinor": 1350 }
}
