{
  "name": "@pos/domain-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript domain logic shared by server and devices: money, rounding, allocation, pricing pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "golden"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
