{
  "name": "@pos/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Testcontainers helpers, cross-tenant harness and the RLS integration suite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain-core": "workspace:*",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "testcontainers": "11.14.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
