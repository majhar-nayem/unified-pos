{
  "alerts": [
    {
      "id": "slo-availability-burn-14.4x-1h",
      "description": "API 5xx ratio over 1h is burning the 99.95 % availability budget at 14.4x",
      "severity": "page",
      "runbook": "docs/runbooks/on-call.md#slo-burn",
      "comparison": "GreaterThanThreshold",
      "threshold": 0.0072,
      "period": 3600,
      "evaluation_periods": 1,
      "treat_missing_data": "notBreaching",
      "notify": false,
      "metrics": [
        {
          "id": "err",
          "metric": {
            "namespace": "AWS/ApplicationELB",
            "name": "HTTPCode_Target_5XX_Count",
            "stat": "Sum",
            "period": 3600,
            "dimensions": {
              "LoadBalancer": "$alb"
            }
          }
        },
        {
          "id": "req",
          "metric": {
            "namespace": "AWS/ApplicationELB",
            "name": "RequestCount",
            "stat": "Sum",
            "period": 3600,
            "dimensions": {
              "LoadBalancer": "$alb"
            }
          }
        },
        {
          "id": "ratio",
          "expression": "IF(req > 0, err / req, 0)",
          "label": "5xx ratio 1h",
          "return_data": true
        }
      ]
    },
