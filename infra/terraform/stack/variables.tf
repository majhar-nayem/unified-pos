variable "environment" {
  description = "dev, staging or prod-au"
  type        = string
  validation {
    condition     = contains(["dev", "staging", "prod-au"], var.environment)
    error_message = "environment must be dev, staging or prod-au."
  }
}

variable "account_id" {
  type = string
}

variable "availability_zones" {
  type = list(string)
}

variable "vpc_cidr" {
  type = string
}

variable "single_nat_gateway" {
  type    = bool
  default = false
}

variable "protect" {
  description = "Deletion protection and final snapshots (true for staging and prod-au)"
  type        = bool
}

variable "aurora" {
  type = object({
    instance_class        = string
    reader_count          = number
    backup_retention_days = number
  })
}

variable "redis" {
  type = object({
    node_type          = string
    num_cache_clusters = number
  })
}

variable "sizing" {
  description = "Fargate size and scale range per service"
  type = object({
    api      = object({ cpu = number, memory = number, desired = number, min = number, max = number })
    worker   = object({ cpu = number, memory = number, desired = number, min = number, max = number })
    payments = object({ cpu = number, memory = number, desired = number, min = number, max = number })
  })
}

variable "image_tag" {
  description = "Seed tag for the first task-definition revisions; CI deploys real tags afterwards"
  type        = string
  default     = "bootstrap"
}

variable "github_repository" {
  type = string
}

variable "github_create_oidc_provider" {
  type    = bool
  default = true
}

variable "github_existing_oidc_provider_arn" {
  type    = string
  default = null
}

variable "alb_certificate_arn" {
  type = string
}

variable "cloudfront_prefix_list_id" {
  type = string
}

variable "origin_domain_name" {
  type    = string
  default = null
}

variable "domain_names" {
  type    = list(string)
  default = []
}

variable "cloudfront_certificate_arn" {
  type    = string
  default = null
}

variable "page_endpoints" {
  type = list(object({
    protocol = string
    endpoint = string
  }))
  default = []
}

variable "ticket_endpoints" {
  type = list(object({
    protocol = string
    endpoint = string
  }))
  default = []
}

variable "state_bucket_arn" {
  type    = string
  default = null
}

variable "alerts_file" {
  description = "Generated by `pnpm --filter @pos/observability alerts:emit`"
  type        = string
  default     = "../../alerts/alerts.json"
}

variable "payments_port" {
  type    = number
  default = 3100
}

variable "canary_interval_minutes" {
  description = "Canary soak before the full traffic shift (prod-au: 30 minutes, the §10 SLO watch)"
  type        = number
  default     = 30
}
